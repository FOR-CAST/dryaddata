and \code{\link[=dryad_use_sandbox]{dryad_use_sandbox()}} for the one-call toggle between Dryad's
production and sandbox deployments.
}
\section{Quick start}{


\if{html}{\out{<div class="sourceCode r">}}\preformatted{# Point the client at Dryad's sandbox while developing.
dryad_use_sandbox()

# Free-text search.
hits <- dryad_search(q = "carbon", per_page = 5)
hits$datasets[, c("identifier", "title")]

# Pull metadata for one dataset and list its files.
ds  <- dryad_dataset("doi:10.5061/dryad.j1fd7")
fls <- dryad_version_files(ds$`_links`$`stash:version`$href)
}\if{html}{\out{</div>}}
}

